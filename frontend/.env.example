# Frontend talks to Supabase using the public (anon) key.
# Get these from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Used by the Edge Function + replay/integration tests.
# This is a shared secret you choose and store in Supabase Edge Function secrets.
WEBHOOK_SECRET=choose_a_long_random_secret

# Optional: enables `npm run test:integration` (live tests against hosted Supabase).
# Use a dedicated test user account.
SUPABASE_TEST_EMAIL=test-user@example.com
SUPABASE_TEST_PASSWORD=use_a_test_user_password

# Required for the tracking live test (`tests/integration/tracking.integration.test.ts`).
# Best practice: use a CI-only device (not one you're watching in the UI).
SUPABASE_TEST_DEVICE_EUI=TEST_DEVEUI_FAKEBOARD001
